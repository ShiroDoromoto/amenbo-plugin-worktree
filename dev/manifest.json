{
  "name": "worktree",
  "desc": "Isolate each task in its own git worktree",
  "author": "amenbo",
  "repo": "ShiroDoromoto/amenbo-plugin-worktree",
  "os": ["macos", "linux", "windows"],
  "category": "workflow",
  "assets": {
    "macos": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v3/worktree-v3-macos-universal.tar.gz",
      "checksum": "sha256:7336210a8e65bad9a95da74c9507ae2a483ed39a440d23d5b9fa43fb8cc78892"
    },
    "linux-x64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v3/worktree-v3-linux-x64.tar.gz",
      "checksum": "sha256:21eba8722b09ff637433de60497609e45266de710bc19103cc0365e98fe4bf26"
    },
    "linux-arm64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v3/worktree-v3-linux-arm64.tar.gz",
      "checksum": "sha256:56548a3f5a1211eef50afa341092936c04404bab6968ea3748904cdd66f39a57"
    },
    "windows-x64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v3/worktree-v3-windows-x64.tar.gz",
      "checksum": "sha256:bc90139cff8bd5d7e60a5209d1e9120fb64761f94b61b8e63201e0466f6f13a7"
    }
  },
  "payload_v": 1,
  "events": ["task.status_changed"],
  "agent": {
    "when": "Starting work on a task that will produce commits, and wanting it isolated",
    "commands": [
      {
        "cmd": "start <task-id>",
        "does": "Cuts a worktree for the task outside the repository, and returns the line to cd into it"
      },
      {
        "cmd": "finish <task-id>",
        "does": "Removes that worktree and its branch, once the work has been merged"
      }
    ]
  }
}
