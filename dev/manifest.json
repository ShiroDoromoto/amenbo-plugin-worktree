{
  "name": "worktree",
  "desc": "Isolate each task in its own git worktree",
  "author": "Amenbo",
  "repo": "ShiroDoromoto/amenbo-plugin-worktree",
  "os": ["macos", "linux", "windows"],
  "category": "workflow",
  "assets": {
    "macos": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v6/worktree-v6-macos-universal.tar.gz",
      "checksum": "sha256:d3bd051a00b0cba171f3c19e8f8d36fbba131c060486112529d9d1782d3ae5c4"
    },
    "linux-x64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v6/worktree-v6-linux-x64.tar.gz",
      "checksum": "sha256:ae4915a73987f392b3139b4bbeb26b5fb0c4496ebf7b8f9dc6ffede9c7a068ee"
    },
    "linux-arm64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v6/worktree-v6-linux-arm64.tar.gz",
      "checksum": "sha256:8cd813e9face25afa74c3a8945b62862d7a327a9f82c240d4e5dc72361c630a1"
    },
    "windows-x64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v6/worktree-v6-windows-x64.tar.gz",
      "checksum": "sha256:5bed16e1fc5c50356219332e49feb8ad929a84b18ca8bdf8ea1ce5a94d5f47af"
    }
  },
  "payload_v": 1,
  "events": ["task.status_changed"],
  "agent": {
    "when": "Starting work on a task that will produce commits, and wanting it isolated",
    "commands": [
      {
        "cmd": "start <task-id>",
        "does": "Cuts a worktree for the task outside the repository, and returns the line to cd into it"
      },
      {
        "cmd": "finish <task-id>",
        "does": "Removes that worktree and its branch, once the work has been merged"
      }
    ]
  }
}
