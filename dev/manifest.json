{
  "name": "worktree",
  "desc": "Isolate each task in its own git worktree",
  "author": "amenbo",
  "repo": "ShiroDoromoto/amenbo-plugin-worktree",
  "os": ["macos", "linux", "windows"],
  "category": "workflow",
  "assets": {
    "macos": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v2/worktree-v2-macos-universal.tar.gz",
      "checksum": "sha256:27da2bdb8fb1814a7a1bc0596077c5505538e7fb147483234368033544b0b6bf"
    },
    "linux-x64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v2/worktree-v2-linux-x64.tar.gz",
      "checksum": "sha256:feaa34e47239ce679f03b0dc6f895233d5b94dcf804d7fa20bc6317b8eb969d4"
    },
    "linux-arm64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v2/worktree-v2-linux-arm64.tar.gz",
      "checksum": "sha256:00a4cd18236be7579797814ee165d3d9c68e0f4672d8c1601dd18ede0d09230f"
    },
    "windows-x64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v2/worktree-v2-windows-x64.tar.gz",
      "checksum": "sha256:481ffde7e10d6be995562c479f1418b2432c27c7bc581f49be8249cf5ab7c291"
    }
  },
  "payload_v": 1,
  "config": [
    { "key": "base", "label": "Base branch", "secret": false, "required": false }
  ],
  "events": ["task.status_changed"],
  "agent": {
    "when": "Starting work on a task that will produce commits, and wanting it isolated",
    "commands": [
      {
        "cmd": "start <task-id>",
        "does": "Cuts a worktree for the task outside the repository, and returns the line to cd into it"
      },
      {
        "cmd": "finish <task-id>",
        "does": "Removes that worktree and its branch, once the work has been merged"
      }
    ]
  }
}
