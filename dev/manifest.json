{
  "name": "worktree",
  "desc": "Isolate each task in its own git worktree",
  "author": "amenbo",
  "repo": "ShiroDoromoto/amenbo-plugin-worktree",
  "os": ["macos", "linux", "windows"],
  "category": "workflow",
  "assets": {
    "macos": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v5/worktree-v5-macos-universal.tar.gz",
      "checksum": "sha256:d284de477cf7161b898b233c4dd4ef34039db1e6af17c030548e9a34713278cf"
    },
    "linux-x64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v5/worktree-v5-linux-x64.tar.gz",
      "checksum": "sha256:92ef7692ff32928c7f88e36ccd708ca803082c68990fd1bc4a42b0dc2b473356"
    },
    "linux-arm64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v5/worktree-v5-linux-arm64.tar.gz",
      "checksum": "sha256:85e5d133f06c097cbaf4f021a6fc89cbac61514e02c7ac05e29c61879a750034"
    },
    "windows-x64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v5/worktree-v5-windows-x64.tar.gz",
      "checksum": "sha256:082e047349fd1730641f4314c638beacb0f378699bf27c30ed259a1daa727a24"
    }
  },
  "payload_v": 1,
  "events": ["task.status_changed"],
  "agent": {
    "when": "Starting work on a task that will produce commits, and wanting it isolated",
    "commands": [
      {
        "cmd": "start <task-id>",
        "does": "Cuts a worktree for the task outside the repository, and returns the line to cd into it"
      },
      {
        "cmd": "finish <task-id>",
        "does": "Removes that worktree and its branch, once the work has been merged"
      }
    ]
  }
}
