{
  "name": "worktree",
  "desc": "Isolate each task in its own git worktree",
  "author": "amenbo",
  "repo": "ShiroDoromoto/amenbo-plugin-worktree",
  "os": ["macos", "linux", "windows"],
  "category": "workflow",
  "assets": {
    "macos": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v4/worktree-v4-macos-universal.tar.gz",
      "checksum": "sha256:f66ef1d8f2e58517430f8868b7e72c0214c1ae39247410c9536e3cd1395c1162"
    },
    "linux-x64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v4/worktree-v4-linux-x64.tar.gz",
      "checksum": "sha256:32924dfc1fb65509054a68e328b401389fea3784deaf4b537ee3b9ce39b74988"
    },
    "linux-arm64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v4/worktree-v4-linux-arm64.tar.gz",
      "checksum": "sha256:06902f67df17c4c5de6dd7ce3b6d69f3f9d11cd3fd157431bd5164e62b72db1e"
    },
    "windows-x64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v4/worktree-v4-windows-x64.tar.gz",
      "checksum": "sha256:4420cb5c5b0a95de1f6409d48bf7ec03571510c3b00ae49c6d58f65d8390714b"
    }
  },
  "payload_v": 1,
  "events": ["task.status_changed"],
  "agent": {
    "when": "Starting work on a task that will produce commits, and wanting it isolated",
    "commands": [
      {
        "cmd": "start <task-id>",
        "does": "Cuts a worktree for the task outside the repository, and returns the line to cd into it"
      },
      {
        "cmd": "finish <task-id>",
        "does": "Removes that worktree and its branch, once the work has been merged"
      }
    ]
  }
}
