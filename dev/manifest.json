{
  "name": "worktree",
  "desc": "Isolate each task in its own git worktree",
  "author": "Amenbo",
  "repo": "ShiroDoromoto/amenbo-plugin-worktree",
  "os": ["macos", "linux", "windows"],
  "category": "workflow",
  "assets": {
    "macos": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v7/worktree-v7-macos-universal.tar.gz",
      "checksum": "sha256:ec78fba3a3a871f1082b5a4b014fe5b4e9f2fef57ae9355e5e30eef5f92a7b95"
    },
    "linux-x64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v7/worktree-v7-linux-x64.tar.gz",
      "checksum": "sha256:1450effe34a7886b59d1d9cc78d97e417420a9db6ef0ece72b3ea8cdd4074cde"
    },
    "linux-arm64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v7/worktree-v7-linux-arm64.tar.gz",
      "checksum": "sha256:53ea97478bef94a972fc9c44972e3d643961e3c0870ddf6085799ef9cb4cae3e"
    },
    "windows-x64": {
      "url": "https://github.com/ShiroDoromoto/amenbo-plugin-worktree/releases/download/v7/worktree-v7-windows-x64.tar.gz",
      "checksum": "sha256:091a5ca876b36e71adff3a662b28b451ae5f81ac9b6a30da94d98d8caa33fa0e"
    }
  },
  "payload_v": 1,
  "events": ["task.status_changed"],
  "agent": {
    "when": "Starting work on a task that will produce commits, and wanting it isolated",
    "commands": [
      {
        "cmd": "start <task-id>",
        "does": "Cuts a worktree for the task outside the repository, and returns the line to cd into it"
      },
      {
        "cmd": "finish <task-id>",
        "does": "Removes that worktree and its branch, once the work has been merged"
      }
    ]
  }
}
